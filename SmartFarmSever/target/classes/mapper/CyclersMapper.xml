<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CyclersMapper">

    <!-- 字段映射 -->
    <resultMap id="CyclersResult" type="com.example.entity.Cyclers">
        <id column="uid" property="uid"/>
        <result column="title" property="title"/>
        <result column="days" property="days"/>
        <result column="remark" property="remark"/>
        <result column="state" property="state"/>
        <result column="createdtime" property="createdtime"/>
        <result column="updatedtime" property="updatedtime"/>
    </resultMap>

    <!-- 动态插入：只插入非空字段，时间默认 now() -->
    <insert id="insertCyclers" parameterType="com.example.entity.Cyclers">
        INSERT INTO cyclers
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="days != null">days,</if>
            <if test="remark != null">remark,</if>
            <if test="state != null">state,</if>
            createdtime,
            updatedtime
            <if test="uid != null">,uid</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="days != null">#{days},</if>
            <if test="remark != null">#{remark},</if>
            <if test="state != null">#{state},</if>
            now(),
            now()
            <if test="uid != null">,#{uid}</if>
        </trim>
    </insert>

    <!-- 动态更新：更新非空字段 + 更新时间 -->
    <update id="updateCyclers" parameterType="com.example.entity.Cyclers">
        UPDATE cyclers
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="days != null">days = #{days},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="state != null">state = #{state},</if>
            updatedtime = now()
        </set>
        WHERE uid = #{uid}
    </update>

    <!-- 分页查询 -->
    <select id="selectListForPage" resultMap="CyclersResult">
        SELECT * FROM cyclers LIMIT #{offset}, #{pageSize}
    </select>

    <!--获取总页码-->
    <select id="countCyclers" resultType="int">
        select count(*) from cyclers
    </select>

    <!-- 模糊查询,基于名称 -->
    <select id="search" resultMap="CyclersResult" parameterType="string">
        SELECT * FROM cyclers
        WHERE title LIKE CONCAT('%', #{title}, '%')
        LIMIT 10
    </select>

</mapper>
